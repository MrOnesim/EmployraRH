DATABASE_URL="postgresql://postgres:postgres@localhost:5432/employepro"
FRONTEND_URL="http://localhost:5173"
PORT=3000
BETTER_AUTH_SECRET="generate-a-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"
QR_SECRET="generate-another-random-secret-at-least-32-chars"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="no-reply@employepro.local"
SENTRY_DSN=""

# RGPD / GDPR data retention (days). Default 1095 = 3 years.
DATA_RETENTION_DAYS="1095"

# Redis cache layer (optional). If unreachable the app runs without caching.
REDIS_URL="redis://localhost:6379"

# MinIO / S3 object storage for the employee vault (optional).
# If MINIO_ENDPOINT is empty, the vault stores only external file URLs.
MINIO_ENDPOINT=""
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="employee-vault"
MINIO_REGION="us-east-1"
