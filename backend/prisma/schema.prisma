generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleEnum {
  SUPER_ADMIN
  ADMIN
  RH
  MANAGER
  DEPARTMENT_HEAD
  EMPLOYEE
  SECURITY_GUARD
}

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  currency  String   @default("EUR")
  country   String   @default("FR")
  logo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            Member[]
  employees          Employee[]
  meetings           Meeting[]
  payrollConfig      PayrollConfig?
  calendarEvents     CalendarEvent[]
  conversations      Conversation[]
  bankAccounts       BankAccount[]
  bankTransactions   BankTransaction[]
  signatureRequests  SignatureRequest[]
  signatureTemplates SignatureTemplate[]
  courses            Course[]
  jobOffers          JobOffer[]
  equipment          Equipment[]
  wellnessSurveys    WellnessSurvey[]
  taxDeclarations    TaxDeclaration[]
  missions           Mission[]
  expenseReports     ExpenseReport[]
  securityGuards     SecurityGuard[]
  terminals          Terminal[]
  invitations        Invitation[]
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  password      String
  image         String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members       Member[]
  employees     Employee[]
  refreshTokens RefreshToken[]

  deletedAt DateTime?
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model Member {
  id        String   @id @default(cuid())
  role      RoleEnum @default(EMPLOYEE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

model Employee {
  id         String   @id @default(cuid())
  firstName  String
  lastName   String
  email      String   @unique
  phone      String?
  position   String?
  department String?
  salary     Float?
  currency   String   @default("EUR")
  hireDate   DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  qrToken          String?
  qrTokenExpiresAt DateTime?

  leaves               Leave[]
  attendance           Attendance[]
  payslips             Payslip[]
  documents            Document[]
  salaryAdvances       SalaryAdvance[]
  salaryTransfers      SalaryTransfer[]
  enrollments          Enrollment[]
  quizAttempts         QuizAttempt[]
  certificates         Certificate[]
  objectives           Objective[]
  performanceReviews   PerformanceReview[]
  missions             Mission[]
  expenseReports       ExpenseReport[]
  equipmentAssignments EquipmentAssignment[]
  wellnessResponses    WellnessResponse[]
  taxDeclarations      TaxDeclaration[]
  securityGuards       SecurityGuard[]

  @@index([companyId])
  @@index([userId])
}

model Leave {
  id        String   @id @default(cuid())
  type      String
  startDate DateTime
  endDate   DateTime
  reason    String?
  status    String   @default("pending")
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model Attendance {
  id         String    @id @default(cuid())
  clockIn    DateTime  @default(now())
  clockOut   DateTime?
  breakStart DateTime?
  breakEnd   DateTime?
  createdAt  DateTime  @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  verifiedById      String?
  verifiedBy        SecurityGuard? @relation(fields: [verifiedById], references: [id], onDelete: SetNull)
  terminalId        String?
  terminal          Terminal?      @relation(fields: [terminalId], references: [id], onDelete: SetNull)
  deviceFingerprint String?
  ipAddress         String?
  scanMethod        String         @default("qr") // qr | manual | nfc | biometric
  qrToken           String?
  status            String         @default("present") // present | late | early | absent | break

  @@index([employeeId])
  @@index([verifiedById])
  @@index([terminalId])
  @@index([qrToken])
}

model Payslip {
  id                 String   @id @default(cuid())
  month              Int
  year               Int
  grossSalary        Float
  netSalary          Float
  totalContributions Float    @default(0)
  incomeTax          Float    @default(0)
  netSocial          Float    @default(0)
  netPayable         Float    @default(0)
  overtimeHours      Float    @default(0)
  overtimePay        Float    @default(0)
  bonusTotal         Float    @default(0)
  rubrics            Json     @default("[]")
  pdfUrl             String?
  createdAt          DateTime @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([employeeId])
}

model Document {
  id        String   @id @default(cuid())
  name      String
  type      String
  url       String
  createdAt DateTime @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model Meeting {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  duration    Int
  link        String?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId    String
  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  participants MeetingParticipant[]

  @@index([companyId])
}

model MeetingParticipant {
  id         String  @id @default(cuid())
  name       String?
  email      String?
  employeeId String?

  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}

model PayrollConfig {
  id                String @id @default(cuid())
  currency          String @default("EUR")
  taxRate           Float  @default(0.15)
  socialChargesRate Float  @default(0.10)
  paymentDay        Int    @default(28)
  overtimeRate      Float  @default(1.25)

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Account {
  id                String    @id
  userId            String
  providerId        String
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([providerId, providerAccountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

// ===== Phase 2 Modules =====

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String // invitation | payment | leave | attendance | payslip | recruitment | objective | review | contract | document
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  time        String?
  location    String?
  type        String // meeting | birthday | holiday | team | training | other
  allDay      Boolean  @default(false)
  createdAt   DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Conversation {
  id                  String   @id @default(cuid())
  participantId       String
  participantName     String
  participantPosition String?
  lastMessage         String?
  unread              Int      @default(0)
  online              Boolean  @default(false)
  createdAt           DateTime @default(now())

  companyId String
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([companyId])
}

model ChatMessage {
  id         String   @id @default(cuid())
  senderId   String
  senderName String
  content    String
  type       String   @default("text") // text | image | file
  createdAt  DateTime @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model BankAccount {
  id             String  @id @default(cuid())
  bankName       String
  accountName    String
  accountNumber  String
  iban           String?
  swift          String?
  currency       String  @default("EUR")
  isMobileMoney  Boolean @default(false)
  mobileProvider String?
  isDefault      Boolean @default(false)

  companyId        String
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankTransactions BankTransaction[]

  @@index([companyId])
}

model BankTransaction {
  id          String   @id @default(cuid())
  type        String // deposit | payment | transfer | withdrawal | fee
  amount      Float
  currency    String   @default("EUR")
  description String?
  reference   String
  status      String   @default("pending") // pending | completed | failed
  date        DateTime @default(now())

  accountId String
  account   BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  companyId String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([accountId])
}

model SalaryAdvance {
  id              String    @id @default(cuid())
  amount          Float
  currency        String    @default("EUR")
  status          String    @default("requested") // requested | approved | paid | rejected
  requestedAt     DateTime  @default(now())
  approvedAt      DateTime?
  paidAt          DateTime?
  repaymentDate   DateTime?
  repaymentStatus String    @default("pending") // pending | repaid | overdue
  repaymentAmount Float?
  reason          String?
  approvedBy      String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model SalaryTransfer {
  id          String    @id @default(cuid())
  amount      Float
  currency    String    @default("EUR")
  type        String // salary | advance | bonus | transfer
  status      String    @default("pending") // pending | completed | failed
  description String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model SignatureRequest {
  id              String    @id @default(cuid())
  documentName    String
  documentType    String // contract | amendment | policy | nda | other
  initiatedBy     String
  initiatedByName String
  status          String    @default("draft") // draft | sent | signed | completed | rejected
  message         String?
  expiresAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  recipients      Json // SignatureRecipient[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model SignatureTemplate {
  id           String  @id @default(cuid())
  name         String
  description  String?
  documentType String
  content      String
  placeholders Json // SignaturePlaceholder[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Course {
  id            String   @id @default(cuid())
  title         String
  description   String?
  category      String
  duration      Int
  instructor    String
  enrolledCount Int      @default(0)
  lessons       Json // Lesson[]
  createdAt     DateTime @default(now())

  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  quizzes      Quiz[]
  certificates Certificate[]

  @@index([companyId])
}

model Enrollment {
  id               String    @id @default(cuid())
  progress         Float     @default(0)
  completedLessons String[] // lesson IDs
  status           String    @default("enrolled") // enrolled | in_progress | completed
  startedAt        DateTime  @default(now())
  completedAt      DateTime?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([employeeId, courseId])
  @@index([employeeId])
}

model Quiz {
  id           String  @id @default(cuid())
  title        String
  description  String?
  passingScore Float   @default(70)
  timeLimit    Int     @default(30)
  questions    Json // QuizQuestion[]

  courseId String
  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  attempts QuizAttempt[]

  @@index([courseId])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  score       Float
  totalPoints Float
  answers     Json // number[]
  passed      Boolean  @default(false)
  startedAt   DateTime @default(now())
  completedAt DateTime @default(now())

  quizId     String
  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([employeeId])
}

model Certificate {
  id             String    @id @default(cuid())
  issuedAt       DateTime  @default(now())
  expiresAt      DateTime?
  certificateUrl String?

  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  verifiedById String?
  verifiedBy   SecurityGuard? @relation(fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([verifiedById])
}

model JobOffer {
  id           String   @id @default(cuid())
  title        String
  department   String
  description  String?
  requirements String?
  salary       Float?
  location     String?
  type         String?
  status       String   @default("open") // open | closed | draft
  createdAt    DateTime @default(now())

  createdBy  String
  companyId  String
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidates Candidate[]

  @@index([companyId])
}

model Candidate {
  id            String    @id @default(cuid())
  firstName     String
  lastName      String
  email         String
  phone         String?
  status        String    @default("received") // received | interview | accepted | rejected
  coverLetter   String?
  resumeUrl     String?
  interviewDate DateTime?
  notes         String?
  appliedAt     DateTime  @default(now())

  jobOfferId String
  jobOffer   JobOffer @relation(fields: [jobOfferId], references: [id], onDelete: Cascade)

  @@index([jobOfferId])
}

model Objective {
  id          String    @id @default(cuid())
  title       String
  description String?
  category    String
  deadline    DateTime?
  status      String    @default("pending") // pending | in_progress | completed | cancelled
  createdAt   DateTime  @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model PerformanceReview {
  id           String   @id @default(cuid())
  rating       Float
  feedback     String?
  strengths    String[]
  improvements String[]
  objectiveIds String[]
  status       String   @default("draft") // draft | submitted | acknowledged
  reviewDate   DateTime @default(now())
  createdAt    DateTime @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reviewerId String

  @@index([employeeId])
}

model Equipment {
  id            String    @id @default(cuid())
  name          String
  type          String // computer | phone | vehicle | access_card | other
  serialNumber  String
  status        String    @default("available") // available | assigned | maintenance | retired
  purchaseDate  DateTime?
  purchasePrice Float?
  condition     String    @default("good") // good | fair | damaged
  notes         String?

  companyId   String
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments EquipmentAssignment[]

  @@index([companyId])
}

model EquipmentAssignment {
  id                    String    @id @default(cuid())
  conditionAtAssignment String    @default("good") // good | fair | damaged
  conditionAtReturn     String?
  assignedAt            DateTime  @default(now())
  returnedAt            DateTime?

  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@index([employeeId])
}

model WellnessSurvey {
  id          String    @id @default(cuid())
  title       String
  description String?
  active      Boolean   @default(true)
  questions   Json // WellnessQuestion[]
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  companyId String
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  responses WellnessResponse[]

  @@index([companyId])
}

model WellnessResponse {
  id          String   @id @default(cuid())
  answers     Json // Record<string, string | number | boolean>
  anonymous   Boolean  @default(false)
  submittedAt DateTime @default(now())

  surveyId   String
  survey     WellnessSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, surveyId])
  @@index([surveyId])
}

model Mission {
  id             String   @id @default(cuid())
  title          String
  destination    String
  startDate      DateTime
  endDate        DateTime
  description    String?
  transportation String?
  accommodation  String?
  budget         Float?
  report         String?
  actualExpenses Float?
  status         String   @default("pending") // pending | approved | rejected | completed
  createdAt      DateTime @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([companyId])
}

model ExpenseReport {
  id              String    @id @default(cuid())
  title           String
  category        String
  amount          Float
  currency        String    @default("EUR")
  description     String?
  receiptUrl      String?
  status          String    @default("pending") // pending | approved | rejected
  approvedBy      String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  missionId  String?
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([companyId])
}

model TaxDeclaration {
  id              String    @id @default(cuid())
  year            Int
  taxType         String // IRPP | CNSS | TVA | IS | other
  taxableIncome   Float
  taxWithheld     Float
  confirmedAmount Float?
  status          String    @default("draft") // draft | submitted | paid
  declarationDate DateTime  @default(now())
  dueDate         DateTime
  paidAt          DateTime?
  notes           String?

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([companyId])
}

model Invitation {
  id        String   @id @default(cuid())
  email     String
  role      RoleEnum @default(EMPLOYEE)
  token     String   @unique
  status    String   @default("pending") // pending | accepted | expired | cancelled
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([email])
}

model SecurityGuard {
  id         String   @id @default(cuid())
  isActive   Boolean  @default(true)
  assignedAt DateTime @default(now())

  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  verifications Attendance[]
  certificates  Certificate[]

  @@unique([employeeId, companyId])
  @@index([companyId])
  @@index([employeeId])
}

model Terminal {
  id                String    @id @default(cuid())
  name              String
  deviceFingerprint String    @unique
  apiKey            String?
  isActive          Boolean   @default(true)
  lastSeenAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  companyId   String
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  attendances Attendance[]

  @@index([companyId])
  @@index([deviceFingerprint])
}

model GdprAccessLog {
  id           String   @id @default(cuid())
  actorId      String
  targetUserId String
  action       String
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([targetUserId])
  @@index([createdAt])
}
